        "IFDEF",
        "IFNDEF",
        "ELSE",
        "ENDIF",
        "REPT",
        "ENDR",
        "ORG",
        "BITS",
        "DEFAULT",
        "COMMON",
        "LOCAL",
        "STRUCT",
        "ENDSTRUCT",
        "UNION",
        "ENDUNION",
        "TYPEDEF",
        "LABEL",
        "PROC",
        "ENDPROC",
        "IMPORT",
        "EXPORT"
